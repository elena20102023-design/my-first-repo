Тип значения "current_condition": массив ([ ... ]), внутри него объект.
Сколько элементов в этом массиве: 1 элемент.
Ключ температуры в Цельсиях: temp_C. В вашем ответе его значение "1", то есть строка. Не путайте с FeelsLikeC: это «ощущается как», там -4.
Что лежит в "weatherDesc": массив из одного объекта с ключом value: [{"value": "Moderate snow"}]. Текст описания погоды («Moderate snow», умеренный снег) находится по ключу value.
Путь до значения температуры:
current_condition[0].temp_C




<!DOCTYPE html> 
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Первый запрос</title>
</head>
<body>
    <h1>Первый запрос</h1>
    <p>Откройте консоль (F12), чтобы увидеть данные о погоде.</p>
    <script>
        async function getWeather() {
            const response = await fetch('https://wttr.in/Moscow?format=j1');
            const data = await response.json();
            console.log(data);
        }

        getWeather();
    </script>
</body>
</html>
    <!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Достаём данные</title>
</head>
<body>
    <h1>Достаём данные</h1>
    <p>Откройте консоль (F12), чтобы увидеть погоду.</p>
    <script>
        async function getWeather() {
            try {
                const response = await fetch('https://wttr.in/Moscow?format=j1');

                if (!response.ok) {
                    throw new Error('Ошибка запроса: ' + response.status);
                }

                const data = await response.json();

                const current = data.current_condition[0];
                const temperature = current.temp_C;
                const humidity = current.humidity;
                const description = current.lang_ru ? current.lang_ru[0].value : current.weatherDesc[0].value;

                console.log(`Температура: ${temperature}°C`);
                console.log(`Влажность: ${humidity}%`);
                console.log(`Погода: ${description}`);
            } catch (error) {
                console.error('Не удалось получить погоду:', error);
            }
        }

        getWeather();
    </script>
</body>
</html>
